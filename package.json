    "@types/node": "^20.17.16",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.2.4",
    "language-subtag-registry": "^0.3.23",
    "postcss": "8.5.10",
    "tailwindcss": "^3.4.17",
    "tsconfig-paths": "^3.15.0",
    "typescript": "^5.7.3"
  },
  "overrides": {
